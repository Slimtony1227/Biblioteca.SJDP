---
const logoUrl = `${import.meta.env.BASE_URL}images/biblioteca-sjdp.jpeg`;
---

<header class="library-header">
  <div class="header-identity">
    <div class="library-logo">
      <img
        src={logoUrl}
        width="1206"
        height="1133"
        alt="Biblioteca Escolar Superior Jardines de Ponce"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <a
      class="instagram-link"
      href="https://www.instagram.com/biblioteca.sjdp/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram de Biblioteca SJDP (se abre en una pestaña nueva)"
      title="@biblioteca.sjdp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    </a>
  </div>
  <h1>Bienvenidos a la biblioteca.</h1>
  <figure class="library-quote">
    <blockquote>
      <p>“The more that you read, the more things you will know. The more that you learn, the more places you'll go.”</p>
    </blockquote>
    <figcaption>— <span class="quote-author">Dr. Seuss</span></figcaption>
  </figure>
</header>
